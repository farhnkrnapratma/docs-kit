{
    "name": "docs-kit",
    "private": true,
    "type": "module",
    "workspaces": ["packages/*"],
    "packageManager": "bun@1.4.5",
    "scripts": {
        "check": "biome check && bun run typecheck",
        "typecheck": "svelte-check --tsconfig ./tsconfig.json",
        "test": "bun tooling/coverage.ts --plain",
        "coverage": "bun tooling/coverage.ts",
        "lint": "biome lint",
        "format": "biome format --write",
        "prepare": "bash tooling/git-hooks/install.sh"
    },
    "devDependencies": {
        "@biomejs/biome": "2.6.9",
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.4",
        "@commitlint/types": "^21.2.3",
        "@happy-dom/global-registrator": "^21.0.4",
        "@sveltejs/kit": "^3.4.1",
        "@types/bun": "1.4.5",
        "@types/node": "^26.6.11",
        "fallow": "^3.48.0",
        "happy-dom": "^21.0.4",
        "svelte": "^5.59.2",
        "svelte-check": "^4.7.8",
        "tailwindcss": "^4.3.5",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "vite": "^8.3.8"
    }
}
