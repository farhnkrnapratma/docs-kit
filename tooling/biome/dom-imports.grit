or {
    `import $_ from $source`,
    `import $source`,
    `export { $_ } from $source`,
    `export * from $source`
} as $import where {
    not $import <: r"import\s+type\s[\s\S]*",
    $source <: r"['\"](?:(?:[^'\"]*/)?server/[^'\"]*|\$app/[^'\"]*|@mdrs/editor[^'\"]*)['\"]",
    register_diagnostic(span=$source, message="@mdrs/dom is the browser side of MDRS: it may depend on docs-ui, the language server highlighter and pelers only.")
}
