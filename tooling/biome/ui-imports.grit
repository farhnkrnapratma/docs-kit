or {
    `import $_ from $source`,
    `import $source`,
    `export { $_ } from $source`,
    `export * from $source`
} as $import where {
    not $import <: r"import\s+type\s[\s\S]*",
    $source <: r"['\"](?:(?:[^'\"]*/)?server/[^'\"]*|\$app/[^'\"]*|@mdrs/[^'\"]*)['\"]",
    register_diagnostic(span=$source, message="docs-ui is the design system: browser-safe, framework-agnostic, and independent of MDRS.")
}
