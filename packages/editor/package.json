{
    "name": "@mdrs/editor",
    "version": "0.1.0",
    "description": "A Svelte editor for MDRS with syntax highlighting, language-server diagnostics, a formatting toolbar and a live preview.",
    "license": "MIT OR Apache-2.0",
    "author": "Farhan Kurnia Pratama",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/farhnkrnapratma/docs-kit.git",
        "directory": "packages/editor"
    },
    "homepage": "https://github.com/farhnkrnapratma/docs-kit#readme",
    "bugs": "https://github.com/farhnkrnapratma/docs-kit/issues",
    "type": "module",
    "sideEffects": ["**/*.css"],
    "svelte": "./src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "svelte": "./src/index.ts",
            "default": "./src/index.ts"
        },
        "./*.svelte": "./src/*.svelte",
        "./*.ts": "./src/*.ts",
        "./*.css": "./src/*.css"
    },
    "files": ["src"],
    "dependencies": {
        "@farhnkrnapratma/docs-ui": "workspace:^",
        "@lucide/svelte": "^1.80.0",
        "@mdrs/dom": "workspace:^",
        "@mdrs/language-server": "^0.3.1",
        "highlight.js": "^11.12.0",
        "katex": "^0.19.1"
    },
    "peerDependencies": {
        "@sveltejs/kit": "^3.4.0",
        "svelte": "^5.59.1"
    },
    "publishConfig": {
        "access": "public"
    }
}
