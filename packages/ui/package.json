{
    "name": "@farhnkrnapratma/docs-ui",
    "version": "0.1.0",
    "description": "Design tokens, Svelte components and stores for the pelers, markers and MDRS documentation sites.",
    "license": "MIT OR Apache-2.0",
    "author": "Farhan Kurnia Pratama",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/farhnkrnapratma/docs-kit.git",
        "directory": "packages/ui"
    },
    "homepage": "https://github.com/farhnkrnapratma/docs-kit#readme",
    "bugs": "https://github.com/farhnkrnapratma/docs-kit/issues",
    "type": "module",
    "svelte": "./src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "svelte": "./src/index.ts",
            "default": "./src/index.ts"
        },
        "./components/*": "./src/components/*",
        "./layout/*": "./src/layout/*",
        "./stores/*": "./src/stores/*",
        "./utils/*": "./src/utils/*",
        "./styles/*": "./src/styles/*",
        "./*.ts": "./src/*.ts",
        "./static/*": "./src/static/*"
    },
    "sideEffects": ["**/*.css"],
    "files": ["src", "!src/**/*.test.ts"],
    "dependencies": {
        "@blobatar/svelte": "^2.7.0",
        "@fontsource-variable/archivo": "^5.3.0",
        "@fontsource-variable/lexend": "^5.3.0",
        "@lucide/svelte": "^1.80.0",
        "bootstrap-icons": "^1.13.2"
    },
    "peerDependencies": {
        "@sveltejs/kit": "^3.4.0",
        "svelte": "^5.59.1"
    },
    "publishConfig": {
        "access": "public"
    }
}
