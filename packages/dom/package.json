{
    "name": "@mdrs/dom",
    "version": "0.2.1",
    "description": "Browser enhancements for MDRS HTML: highlighted code blocks, tabs, charts, Mermaid diagrams drawn by pelers, and heading anchors.",
    "license": "MIT OR Apache-2.0",
    "author": "Farhan Kurnia Pratama",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/farhnkrnapratma/docs-kit.git",
        "directory": "packages/dom"
    },
    "homepage": "https://github.com/farhnkrnapratma/docs-kit#readme",
    "bugs": "https://github.com/farhnkrnapratma/docs-kit/issues",
    "type": "module",
    "sideEffects": ["**/*.css"],
    "svelte": "./src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "svelte": "./src/index.ts",
            "default": "./src/index.ts"
        },
        "./*.svelte": "./src/*.svelte",
        "./*.ts": "./src/*.ts",
        "./*.css": "./src/*.css"
    },
    "files": ["src"],
    "dependencies": {
        "@farhnkrnapratma/docs-ui": "workspace:^",
        "@farhnkrnapratma/pelers": "^1.0.0-alpha4",
        "@lucide/svelte": "^1.80.0",
        "@mdrs/language-server": "^0.3.1",
        "d3-scale": "^4.0.3",
        "d3-shape": "^3.2.1",
        "highlight.js": "^11.12.0",
        "js-yaml": "^5.5.0",
        "layerchart": "^2.12.0",
        "mermaid": "^12.3.0"
    },
    "devDependencies": {
        "@types/d3-scale": "^4.0.9",
        "@types/d3-shape": "^3.2.0"
    },
    "peerDependencies": {
        "@sveltejs/kit": "^3.4.0",
        "svelte": "^5.59.1"
    },
    "publishConfig": {
        "access": "public"
    }
}
